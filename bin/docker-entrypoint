#!/bin/bash -e

# If running the rails server then create or migrate existing database, then seed it.
# db:seed is idempotent (find_or_create_by!), so it's safe to run on every boot even
# against an already-seeded database.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
