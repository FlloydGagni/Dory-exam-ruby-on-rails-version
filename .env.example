# Copy this file to .env for local reference (Rails primarily uses config/credentials.yml.enc + config/master.key,
# but these are the equivalent values needed to run this app, including in deployment env vars).

DATABASE_URL=postgres://user:password@localhost:5432/dory_task_tracker_development
RAILS_MASTER_KEY=paste_your_local_config/master.key_value_here_for_local_reference_only
RAILS_ENV=development
