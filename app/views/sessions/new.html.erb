<h1>Sign In</h1>

<% if flash[:alert] %>
  <div style="color: red;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with url: login_path, local: true do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, name: "email" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, name: "password" %>
  </div>

  <div>
    <%= form.submit "Sign In" %>
  </div>
<% end %>

<p>Don't have an account? <%= link_to "Sign Up", signup_path %></p>