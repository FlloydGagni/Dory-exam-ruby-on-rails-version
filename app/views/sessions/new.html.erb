<%# Sign-in form, rendered by SessionsController#new. Also the app's root page (`/`). %>
<div class="mx-auto max-w-sm">
  <div class="card">
    <h1 class="mb-6 text-center text-xl font-semibold text-slate-900">Sign In</h1>

    <%# Not bound to a model (no `model:` option) since credentials aren't a persisted record;
        submits a plain POST to /login, handled by SessionsController#create. `name:` is set
        explicitly on each field so params arrive as top-level `params[:email]`/`params[:password]`
        rather than nested under a form object name. %>
    <%= form_with url: login_path, local: true, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :email, class: "field-label" %>
        <%= form.email_field :email, name: "email", class: "field-input" %>
      </div>

      <div>
        <%= form.label :password, class: "field-label" %>
        <%= form.password_field :password, name: "password", class: "field-input" %>
      </div>

      <div>
        <%= form.submit "Sign In", class: "btn-primary w-full" %>
      </div>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-slate-500">Don't have an account? <%= link_to "Sign Up", signup_path, class: "link" %></p>
</div>
