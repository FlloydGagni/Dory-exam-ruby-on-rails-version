<div class="mx-auto max-w-sm">
  <div class="card">
    <h1 class="mb-6 text-center text-xl font-semibold text-slate-900">Sign Up</h1>

    <%= render "shared/error_messages", object: @user %>

    <%= form_with model: @user, url: signup_path, local: true, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, class: "field-input" %>
      </div>

      <div>
        <%= form.label :email, class: "field-label" %>
        <%= form.email_field :email, class: "field-input" %>
      </div>

      <div>
        <%= form.label :password, class: "field-label" %>
        <%= form.password_field :password, class: "field-input" %>
      </div>

      <div>
        <%= form.label :password_confirmation, class: "field-label" %>
        <%= form.password_field :password_confirmation, class: "field-input" %>
      </div>

      <div>
        <%= form.submit "Sign Up", class: "btn-primary w-full" %>
      </div>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-slate-500">Already have an account? <%= link_to "Sign In", login_path, class: "link" %></p>
</div>
