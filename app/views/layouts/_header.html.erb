<%# Top navigation bar, only rendered for signed-in users (see layouts/application.html.erb). %>
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <%# App name doubles as a "home" link back to the task list. %>
    <%= link_to "Dory Task Tracker", tasks_path, class: "text-lg font-semibold text-slate-900" %>
    <nav class="flex items-center gap-4 text-sm">
      <%= link_to "Tasks", tasks_path, class: "link" %>
      <%= link_to "Categories", categories_path, class: "link" %>
      <span class="text-slate-300">|</span>
      <%# current_user is guaranteed present here since the header only renders when logged_in?. %>
      <span class="text-slate-500"><%= current_user.name %></span>
      <%# turbo_method: :delete makes this plain link issue a DELETE request (logout route),
          since a normal <a> tag can only ever issue a GET. %>
      <%= link_to "Log Out", logout_path, data: { turbo_method: :delete }, class: "link" %>
    </nav>
  </div>
</header>
