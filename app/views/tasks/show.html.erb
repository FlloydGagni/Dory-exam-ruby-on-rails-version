<div class="card">
  <h1 class="text-2xl font-semibold text-slate-900"><%= @task.title %></h1>

  <dl class="mt-4 divide-y divide-slate-100 text-sm">
    <div class="flex justify-between py-2">
      <dt class="font-medium text-slate-500">Status</dt>
      <dd><span class="<%= status_badge_classes(@task.status) %>"><%= @task.status.humanize %></span></dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="font-medium text-slate-500">Category</dt>
      <dd><%= @task.category.name %></dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="font-medium text-slate-500">Due Date</dt>
      <dd><%= @task.due_date&.strftime("%b %d, %Y") || "No due date" %></dd>
    </div>
    <div class="py-2">
      <dt class="font-medium text-slate-500">Description</dt>
      <dd class="mt-1"><%= @task.description.presence || "No description" %></dd>
    </div>
  </dl>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to "Edit", edit_task_path(@task), class: "btn-secondary" %>
    <%= link_to "Delete", task_path(@task), data: { turbo_method: :delete, turbo_confirm: "Delete \"#{@task.title}\"? This cannot be undone." }, class: "btn-danger" %>
    <%= link_to "Back to Tasks", tasks_path, class: "link" %>
  </div>
</div>
